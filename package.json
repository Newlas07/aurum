{
  "name": "aurum",
  "version": "2.0.0",
  "private": true,
  "description": "Aurum - aplicação de finanças pessoais",
  "type": "commonjs",
  "scripts": {
    "test": "node --test --test-isolation=none test/*.test.cjs",
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node scripts/dev.cjs",
    "security:audit": "pnpm audit --prod --audit-level high"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
